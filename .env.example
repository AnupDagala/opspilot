# No key: prominently labelled Scripted demo mode.
# Replace the blank API key locally; never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Replace with a provider model supporting Chat Completions function tools.
OPENAI_MODEL=gpt-4.1-mini
# 1 forces deterministic scripted mode even if a key exists.
OPSPILOT_SCRIPTED=0
